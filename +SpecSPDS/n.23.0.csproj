<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="Shared.props" Condition="Exists('Shared.props')" />
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyName>$(SolutionName)$(MSBuildProjectName)</AssemblyName>
		<!--<RootNamespace>dRz.SpecSPDS.nCad</RootNamespace>-->
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<UseWindowsForms>false</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<!--******************-->
		<Description>Спецификация из универсального маркера, nanoCAD 23-25</Description>
		<AssemblyTitle>SpecSPDS.NET.23</AssemblyTitle>
		<!--metadata-->
		<HostFamily>NC</HostFamily>
		<HostCode>n</HostCode>

	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);$(HostFamily)</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MultiCAD.NET" Version="23.0.6177.4117" />
		<PackageReference Include="nanoCAD.Platform.NET" Version="23.0.6177.4117" />
	</ItemGroup>
	<!--metadata assemble-->
	<ItemGroup>
		<AssemblyMetadata Include="HostFamily" Value="$(HostFamily)" />
		<AssemblyMetadata Include="HostCode" Value="$(HostCode)" />
	</ItemGroup>

</Project>
