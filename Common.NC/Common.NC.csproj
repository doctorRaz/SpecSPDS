<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(SolutionDir)Directory.Build.props" Condition="'$(SpecSPDSDirectoryBuildImported)' != 'true' And Exists('$(SolutionDir)Directory.Build.props')" />
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<Description>Общие служебные команды nanoCAD</Description>
		<HostFamily>NC</HostFamily>
		<HostCode>n</HostCode>
		<DefineConstants>$(DefineConstants);$(HostFamily)</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="nanoCAD.Platform.NET" Version="23.1.6324.4405" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Abstractions\Abstractions.csproj" />
		<ProjectReference Include="..\Updater\Updater.csproj" />
	</ItemGroup>
		<!-- Генерация префикса команд из имени проекта для CommandMethod. -->
	<Target Name="GenerateCommandPrefix" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_CommandPrefixFile>$(IntermediateOutputPath)CommandPrefix.g.cs</_CommandPrefixFile>
			<_CommandPrefixValue>drz_$(SolutionName)</_CommandPrefixValue>
		</PropertyGroup>
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<WriteLinesToFile File="$(_CommandPrefixFile)" Overwrite="true" Lines="internal static class CommandPrefix { public const string Value = &quot;$(_CommandPrefixValue)&quot;%3B  }" />
		<ItemGroup>
			<Compile Include="$(_CommandPrefixFile)" />
		</ItemGroup>
	</Target>
</Project>
