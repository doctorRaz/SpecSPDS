<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--<TargetFramework>net6.0-windows</TargetFramework>-->
		<TargetFramework>net462</TargetFramework>
		<OutputType>Exe</OutputType>
		<PlatformTarget>x64</PlatformTarget>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<UseWPF>true</UseWPF>
		<!-- значение по умолчанию мин версии-->
		<MinVersion Condition="'$(MinVersion)' == ''">20</MinVersion>
		<!--для GeneratedCompile.cs не удалять-->
		<SolutionNameSafe Condition="'$(SolutionName)'==''">NoSolution</SolutionNameSafe>
		<SolutionNameSafe Condition="'$(SolutionName)'!=''">$(SolutionName)</SolutionNameSafe>
		<!--*******-->

		<Description>Отладка в консоли</Description>
		<RootNamespace>drz.$(MSBuildProjectName)</RootNamespace>
		<AssemblyTitle>$(SolutionName).Cmd</AssemblyTitle>

		<!--metadata-->
		<HostFamily>RawData</HostFamily>
		<HostCode>rd</HostCode>
		<Vendor>dRz</Vendor>

	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);$(HostFamily)</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\+Abstractions\Abstractions.csproj" />
		<ProjectReference Include="..\+Infrastructure\Infrastructure.csproj" />
		<ProjectReference Include="..\+Test.AddOnRuntime\Test.AddOnRuntime.csproj" />
		<ProjectReference Include="..\+Test.CloneA\Test.CloneA.csproj" />
		<ProjectReference Include="..\+Test.CloneB\Test.CloneB.csproj" />
		<ProjectReference Include="..\+Test.LibA\Test.LibA.csproj" />
		<ProjectReference Include="..\+Updater\Updater.csproj" />
	</ItemGroup>
	<!--metadata assemble-->
	<ItemGroup>
		<!-- Контактная информация -->
		<AssemblyMetadata Include="ContactEmail" Value="razygraev@gmail.com" />
		<AssemblyMetadata Include="SupportEmail" Value="doctorRaz@gmail.com" />
		<AssemblyMetadata Include="VendorEmail" Value="doctorRaz@yandex.ry" />

		<!--домашняя страница-->
		<AssemblyMetadata Include="HomePage" Value="https://doctorraz.blogspot.com" />

		<!-- Семейство Host -->
		<AssemblyMetadata Include="HostFamily" Value="$(HostFamily)" />

		<!-- Код Host -->
		<AssemblyMetadata Include="HostCode" Value="$(HostCode)" />

		<!--Product может быть красивым названием, а ProductFamily удобно использовать программно.-->
		<AssemblyMetadata Include="ProductFamily" Value="$(HostFamily).$(SolutionName)" />

		<AssemblyMetadata Include="Vendor" Value="$(Vendor)" />

	</ItemGroup>
	<!-- Генерация класса с константой MinVersion перед сборкой -->
	<!--https://chatgpt.com/c/69bf9254-02bc-832c-bfb7-5da312cc712a-->
	<Target Name="GeneratedCompile" BeforeTargets="PrepareForBuild">
		<WriteLinesToFile File="$(IntermediateOutputPath)GeneratedCompile.cs" Overwrite="true" Lines="&#xD;&#xA;namespace drz.Loader&#xD;&#xA;{&#xD;&#xA;    public static class GeneratedCompile&#xD;&#xA;    {&#xD;&#xA;        public const int MinVersion = $(MinVersion)%3B&#xD;&#xA;        public const string CommandSuf = &quot;$(SolutionNameSafe)&quot;%3B&#xD;&#xA;    }&#xD;&#xA;}" />
	</Target>
	<ItemGroup>
		<Compile Include="$(IntermediateOutputPath)GeneratedCompile.cs" Visible="false" />
		<Compile Include="..\src\**\*.cs" Link="\%(RecursiveDir)%(Filename)%(Extension)" />
		<!--<Compile Include="..\+Loader\EntryPoint.cs" Link="Loader\EntryPoint.cs" />-->
	</ItemGroup>

</Project>
