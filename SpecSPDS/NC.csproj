<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="Shared.props" Condition="Exists('Shared.props')" />
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Description>Спецификация из универсального маркера, nanoCAD 23-26</Description>
		<AssemblyTitle>$(SolutionName).$(MSBuildProjectName)</AssemblyTitle>
		<!--metadata-->
		<HostFamily>NC</HostFamily>
		<HostCode>n</HostCode>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);$(HostFamily)</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MultiCAD.NET" Version="23.1.6324.4405" />
		<PackageReference Include="nanoCAD.Platform.NET" Version="23.1.6324.4405" />
	</ItemGroup>
	<!--metadata assemble-->
	<ItemGroup>
		<AssemblyMetadata Include="HostFamily" Value="$(HostFamily)" />
		<AssemblyMetadata Include="HostCode" Value="$(HostCode)" />
	</ItemGroup>

</Project>
