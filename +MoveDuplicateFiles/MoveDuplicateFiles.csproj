<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<OutputType>Exe</OutputType>
		<PlatformTarget>x64</PlatformTarget>
		<Nullable>enable</Nullable>
		<AssemblyName>$(SolutionName).$(MSBuildProjectName)</AssemblyName>
		<UseWPF>true</UseWPF>
		<Description>Отладка в консоли</Description>
		<RootNamespace>drz.$(MSBuildProjectName)</RootNamespace>
		<AssemblyTitle>$(MSBuildProjectName)</AssemblyTitle>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);$(CadFamily)</DefineConstants>
		<ApplicationIcon>Refresh.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
	  <Content Include="Refresh.ico" />
	</ItemGroup>
</Project>
