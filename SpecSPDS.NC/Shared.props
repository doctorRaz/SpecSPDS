<Project>
	<PropertyGroup>
	</PropertyGroup>
	<!--<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>-->
	<ItemGroup>
		<ProjectReference Include="..\Abstractions\Abstractions.csproj" />
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\Updater\Updater.csproj" />
		<ProjectReference Include="..\MulticadInterop\MulticadInterop.csproj" />
		<!--<ProjectReference Include="..\EnvironmentInfo\EnvironmentInfo.csproj" />-->

		<ProjectReference Include="..\AddOnRuntime\AddOnRuntime.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!--<PackageReference Include="drzNLog" Version="6.1.0-drz" />-->
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\src\**\*.cs" Link="\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
<!-- Генерация префикса команд из имени проекта для CommandMethod. -->
<Target Name="GenerateCommandPrefix" BeforeTargets="CoreCompile">
    <PropertyGroup>
        <_CommandPrefixFile>$(IntermediateOutputPath)CommandPrefix.g.cs</_CommandPrefixFile>
        <_CommandPrefixValue Condition="'$(Configuration)' == 'Debug'">$(MSBuildProjectName)-</_CommandPrefixValue>
        <_CommandPrefixValue Condition="'$(Configuration)' != 'Debug'"></_CommandPrefixValue>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />

    <WriteLinesToFile
        File="$(_CommandPrefixFile)"
        Overwrite="true"
        Lines="internal static class CommandPrefix { public const string Value = &quot;$(_CommandPrefixValue)&quot;%3B  }" />

    <ItemGroup>
        <Compile Include="$(_CommandPrefixFile)" />
    </ItemGroup>
</Target>
</Project>