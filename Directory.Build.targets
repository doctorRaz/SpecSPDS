<Project>
	<PropertyGroup>
		<!-- Полная версия CLR -->
		<AssemblyVersion>$(Version).$(Build).$(Revision)</AssemblyVersion>
		<!-- Версия файла Windows -->
		<FileVersion>$(Version).$(Build).$(Revision)</FileVersion>
		<!-- Версия продукта для пользователя -->
		<!-- ProductVersion он жэж AssemblyInformationalVersion-->
		<InformationalVersion>$(Version).$(Build).$(Revision)</InformationalVersion>
		<!-- Не добавлять Git commit hash в InformationalVersion -->
		<!--<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>-->
	</PropertyGroup>
	<!-- что бы в каждый проект не добавлять -->
	<ItemGroup>
		<!-- Удаляем ВСЕ из _draft -->
		<Compile Remove="**/_draft/**"/>
		<EmbeddedResource Remove="**/_draft/**"/>
		<None Remove="**/_draft/**"/>
		<Content Remove="**/_draft/**"/>
		<!-- Удаляем ВСЕ из _experimental -->
		<Compile Remove="**/_experimental/**"/>
		<EmbeddedResource Remove="**/_experimental/**"/>
		<None Remove="**/_experimental/**"/>
		<Content Remove="**/_experimental/**"/>
	</ItemGroup>

	<!-- Генерация префикса команд из имени проекта для CommandMethod. -->
	<Target Name="GenerateCommandPrefix"
	        BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_CommandPrefixFile>$(IntermediateOutputPath)CommandPrefix.g.cs</_CommandPrefixFile>
		</PropertyGroup>
		<MakeDir Directories="$(IntermediateOutputPath)"/>
		<WriteLinesToFile
			File="$(_CommandPrefixFile)"
			Overwrite="true"
			Lines="internal static class CommandPrefix { public const string Value = &quot;$(MSBuildProjectName)&quot;%3B }"/>
		<ItemGroup>
			<Compile Include="$(_CommandPrefixFile)"/>
		</ItemGroup>
	</Target>
</Project>
