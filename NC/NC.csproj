<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Description>Спецификация из универсального маркера, nanoCAD 23-26</Description>
		<!--metadata-->
		<HostFamily>NC</HostFamily>
		<HostCode>n</HostCode>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);$(HostFamily)</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MultiCAD.NET" Version="23.1.6324.4405" />
		<PackageReference Include="nanoCAD.Platform.NET" Version="23.1.6324.4405" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Abstractions\Abstractions.csproj" />
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\Updater\Updater.csproj" />
		<ProjectReference Include="..\MulticadInterop\MulticadInterop.csproj" />
		<ProjectReference Include="..\Application\Application.csproj" />
		<ProjectReference Include="..\AddOnRuntime\AddOnRuntime.csproj" />
		<ProjectReference Include="..\Common.NC\Common.NC.csproj" />
	</ItemGroup>
	<!-- Генерация префикса команд из имени проекта для CommandMethod. -->
	<Target Name="GenerateCommandPrefix" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_CommandPrefixFile>$(IntermediateOutputPath)CommandPrefix.g.cs</_CommandPrefixFile>
			<_CommandPrefixValue>drz_$(SolutionName)</_CommandPrefixValue>
		</PropertyGroup>
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<WriteLinesToFile
			File="$(_CommandPrefixFile)"
			Overwrite="true"
			Lines="internal static class CommandPrefix { public const string Value = &quot;$(_CommandPrefixValue)&quot;%3B  }" />
		<ItemGroup>
			<Compile Include="$(_CommandPrefixFile)" />
		</ItemGroup>
	</Target>
</Project>
