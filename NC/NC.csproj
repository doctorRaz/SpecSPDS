<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Description>Спецификация из универсального маркера, nanoCAD 23-26</Description>
		<!--metadata-->
		<HostFamily>NC</HostFamily>
		<HostCode>n</HostCode>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);$(HostFamily)</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MultiCAD.NET" Version="23.1.6324.4405" />
		<PackageReference Include="nanoCAD.Platform.NET" Version="23.1.6324.4405" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Abstractions\Abstractions.csproj" />
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\MulticadInterop\MulticadInterop.csproj" />
		<ProjectReference Include="..\Application\Application.csproj" />
		<ProjectReference Include="..\AddOnRuntime\AddOnRuntime.csproj" />
		<ProjectReference Include="..\Common.NC\Common.NC.csproj" />
	</ItemGroup>
	<!-- Генерация префикса команд из имени проекта для CommandMethod. -->
	<Target Name="GenerateCommandPrefix" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<CommandPrefixFile>$(IntermediateOutputPath)CommandPrefix.g.cs</CommandPrefixFile>
			<CommandPrefixValue>drz_$(SolutionName)</CommandPrefixValue>
		</PropertyGroup>
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<WriteLinesToFile File="$(CommandPrefixFile)" Overwrite="true" Lines=
"
///&lt;summary&gt; Содержит константы, генерируемые перед сборкой.&lt;/summary&gt;
internal static class CommandPrefix 
{ 
/// &lt;summary&gt; Суффикс команд, формируемый из имени решения. &lt;/summary&gt;
public const string Value = &quot;$(CommandPrefixValue)&quot;%3B  
}" />
		<ItemGroup>
			<Compile Include="$(CommandPrefixFile)" />
		</ItemGroup>
	</Target>
</Project>
